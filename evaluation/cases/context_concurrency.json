  {
    "id": "context-tool-ownership",
    "category": "context_concurrency",
    "version": 1,
    "description": "context tool ownership",
    "input": "context first",
    "history": [],
    "fixtures": {},
    "expected_status": "SUCCEEDED",
    "turns": [
      {
        "id": "t1",
        "input": "context first",
        "session": "a",
        "expected_status": "SUCCEEDED",
        "provider": [
          {
            "tool_calls": [
              {
                "id": "c1",
                "name": "record_context",
                "arguments": {}
              }
            ]
          },
          {
            "from_tool": true
          }
        ],
        "channel": "telegram",
        "chat_id": "100"
      },
      {
        "id": "t2",
        "input": "context second",
        "session": "b",
        "expected_status": "SUCCEEDED",
        "provider": [
          {
            "tool_calls": [
              {
                "id": "c2",
                "name": "record_context",
                "arguments": {}
              }
            ]
          },
          {
            "from_tool": true
          }
        ],
        "channel": "discord",
        "chat_id": "200"
      }
    ],
    "scenario": "context",
    "tools": {
      "required_tools": [
        "record_context"
      ],
      "allowed_tools": [
        "record_context"
      ],
      "forbidden_tools": [
        "exec",
        "spawn",
        "cron",
        "web_search",
        "web_fetch"
      ],
      "expected_calls": [
        {
          "turn": "t1",
          "name": "record_context",
          "arguments": {}
        },
        {
          "turn": "t2",
          "name": "record_context",
          "arguments": {}
        }
      ]
    },
    "assertions": [
      {
        "turn": "t1",
        "kind": "json_equals",
        "value": {
          "session": "eval:a",
          "channel": "telegram",
          "chat_id": "100",
          "message_id": "m-t1"
        }
      },
      {
        "turn": "t2",
        "kind": "json_equals",
        "value": {
          "session": "eval:b",
          "channel": "discord",
          "chat_id": "200",
          "message_id": "m-t2"
        }
      }
    ],
    "judge_rubric": null,
    "real_model": false,
    "business_task": true
  },
