# Copy to .env and run make deploy-up. Values are validated; never source this file.
COMPOSE_PROJECT_NAME=membot
POSTGRES_PASSWORD=replace_with_random_url_safe_password
MEMBOT_PUBLIC_HOST=agent.example.com
MEMBOT_BIND_IP=127.0.0.1
MEMBOT_HTTP_PORT=8088
MEMBOT_HTTPS_PORT=8443
MEMBOT_TLS_DIR=./certs
MEMBOT_LLM_API_KEY_FILE=./secrets/llm_api_key
MEMBOT_PROVIDER=litellm
MEMBOT_MODEL=gpt-4o-mini
MEMBOT_PROVIDER_BASE_URL=
MEMBOT_ALLOW_FAKE_PROVIDER=false
MEMBOT_OWNER_ID=default
MEMBOT_IMAGE_TAG=m5-local
MEMBOT_NETWORK_SUBNET=172.29.55.0/24
MEMBOT_MAX_UNFINISHED=1024
MEMBOT_MAX_PAYLOAD_BYTES=1048576
MEMBOT_MAX_ITERATIONS=40
MEMBOT_WORKER_CONCURRENCY=4
MEMBOT_WORKER_PREFETCH=8
MEMBOT_REDIS_STREAM_MAX_DEPTH=1024
MEMBOT_QUEUE_TIMEOUT_SECONDS=300
MEMBOT_EXECUTION_TIMEOUT_SECONDS=300
MEMBOT_LLM_TIMEOUT_SECONDS=120
MEMBOT_TOOL_TIMEOUT_SECONDS=60
MEMBOT_DIAGNOSTIC_PAYLOAD_BYTES=65536
MEMBOT_DIAGNOSTIC_RETENTION_DAYS=7
# Fixed official tags and digests are loaded from deploy/images.env.
# To use a registry cache, override the registry path while preserving digest.
